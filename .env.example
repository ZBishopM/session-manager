# Env vars read by pb_hooks/*.pb.js via $os.getenv() — these must be real
# OS environment variables on whatever process runs `pocketbase serve`
# (PM2 env in prod, your shell in local dev). PocketBase does not load a
# .env file itself; this file is documentation, not auto-loaded config.
# Every one of these is optional — each hook skips (and logs) its feature
# if unset, nothing crashes without them.

# --- Achievements (pb_hooks/game_created.pb.js) ---
GEMINI_API_KEY=

# --- Weekly matchmaking notifications (pb_hooks/weekly_matchmaker.pb.js) ---
# Site origin used to build /invite/[token] links.
PUBLIC_URL=https://gamesessions.danassistantassistant.website
# Discord channel webhook (Server Settings -> Integrations -> Webhooks).
DISCORD_WEBHOOK_URL=

# --- Email (pb_hooks/mail_config.pb.js) ---
# SMTP_HOST/SMTP_PASSWORD are the two that gate the feature on/off — set
# both or neither. See docs/DEPLOYMENT.md and pendientes/gamesessions.md
# for the current mail.agapornis.app / Stalwart setup.
SMTP_HOST=mail.agapornis.app
SMTP_PORT=465
SMTP_USERNAME=notify@agapornis.app
SMTP_PASSWORD=
SMTP_FROM=notify@agapornis.app
