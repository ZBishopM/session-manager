{
  "name": "session-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mobile-first web app for managing board game sessions in physical meetups",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "build:migrations": "tsx scripts/build-migrations.ts",
    "check:migrations": "npm run build:migrations && git diff --exit-code pb_migrations/",
    "build:hooks": "tsx scripts/build-hooks.ts",
    "check:hooks": "npm run build:hooks && git diff --exit-code pb_hooks/_core.js"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.5.18",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^1.6.0",
    "esbuild": "^0.21.0",
    "jsdom": "^24.1.0",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
