{
  "name": "session-manager",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Mobile-first web app for managing board game sessions in physical meetups",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "svelte-kit sync && tsc --noEmit",
    "build:migrations": "tsx scripts/build-migrations.ts",
    "check:migrations": "pnpm run build:migrations && git diff --exit-code pb_migrations/",
    "build:hooks": "tsx scripts/build-hooks.ts",
    "check:hooks": "pnpm run build:hooks && git diff --exit-code pb_hooks/_core.js",
    "build:types": "tsx scripts/build-types.ts",
    "check:types": "pnpm run build:types && git diff --exit-code src/lib/core/records.ts",
    "fetch:pocketbase": "tsx scripts/fetch-pocketbase.ts",
    "test:integration": "tsx scripts/fetch-pocketbase.ts && vitest run tests/integration --config vitest.integration.config.ts",
    "test:e2e": "tsx scripts/fetch-pocketbase.ts && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.5.18",
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/svelte": "^5.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/adm-zip": "^0.5.5",
    "@types/node": "^20.11.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@vitest/coverage-v8": "^1.6.0",
    "adm-zip": "^0.5.14",
    "esbuild": "^0.21.0",
    "jsdom": "^24.1.0",
    "svelte": "^4.2.18",
    "svelte-check": "^3.8.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^1.6.0",
    "workbox-window": "^7.4.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "pocketbase": "^0.26.8",
    "qrcode": "^1.5.4"
  }
}
